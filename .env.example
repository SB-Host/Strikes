# --- Local development -------------------------------------------------
# Leave these as-is and the app writes to a SQLite file in the repo root.
DATABASE_URL="file:./strikes.db"

# --- Production (Turso / libSQL) ---------------------------------------
# Create a free database at https://turso.tech, then paste the two values:
# DATABASE_URL="libsql://your-db-name.turso.io"
# DATABASE_AUTH_TOKEN="ey..."

# Signs the login cookie. Generate one with:  openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"

# The PIN handed to the first owner account on first boot.
OWNER_NAME="Sawyer"
OWNER_HANDLE="sawyer"
OWNER_PIN="246810"
